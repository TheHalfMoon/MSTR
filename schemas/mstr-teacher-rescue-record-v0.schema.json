{
  "$defs": {
    "execution_binding": {
      "additionalProperties": false,
      "properties": {
        "environment_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "evidence_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "output_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR"
          ]
        },
        "sandboxed": {
          "type": "boolean"
        }
      },
      "required": [
        "output_id",
        "environment_identity",
        "sandboxed",
        "result",
        "evidence_identity"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "lineage_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "UNRESOLVED"
          ]
        },
        "source_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "source_revision": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_identity",
        "source_revision",
        "lineage_status"
      ],
      "type": "object"
    },
    "provenance_binding": {
      "additionalProperties": false,
      "properties": {
        "output_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "output_id",
        "provenance"
      ],
      "type": "object"
    },
    "rights": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "COMPATIBLE",
            "INCOMPATIBLE",
            "UNRESOLVED"
          ]
        },
        "license_or_terms_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "license_or_terms_identity",
        "decision"
      ],
      "type": "object"
    },
    "rights_binding": {
      "additionalProperties": false,
      "properties": {
        "output_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "rights_decision": {
          "$ref": "#/$defs/rights"
        }
      },
      "required": [
        "output_id",
        "rights_decision"
      ],
      "type": "object"
    },
    "student_model_identity": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "harness_profile_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "model_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "sampling_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "checkpoint_id",
        "harness_profile_id",
        "sampling_identity"
      ],
      "type": "object"
    },
    "teacher_output": {
      "additionalProperties": false,
      "properties": {
        "contamination_status": {
          "enum": [
            "CLEAR",
            "DETECTED",
            "UNRESOLVED"
          ]
        },
        "content_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "execution_required": {
          "type": "boolean"
        },
        "output_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "output_kind": {
          "enum": [
            "SOLUTION",
            "TEST",
            "REVIEW",
            "REFERENCE"
          ]
        }
      },
      "required": [
        "output_id",
        "output_kind",
        "content_identity",
        "contamination_status",
        "execution_required"
      ],
      "type": "object"
    }
  },
  "$id": "https://mstr.local/schemas/mstr-teacher-rescue-record-v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "admission_decision": {
            "const": "ADMIT"
          }
        },
        "required": [
          "admission_decision"
        ]
      },
      "then": {
        "properties": {
          "admission_reasons": {
            "maxItems": 0
          },
          "contamination_status": {
            "const": "CLEAR"
          },
          "independent_execution_results": {
            "items": {
              "properties": {
                "result": {
                  "const": "PASS"
                },
                "sandboxed": {
                  "const": true
                }
              }
            }
          },
          "output_provenance": {
            "items": {
              "properties": {
                "provenance": {
                  "properties": {
                    "lineage_status": {
                      "const": "COMPLETE"
                    }
                  }
                }
              }
            }
          },
          "output_rights_decisions": {
            "items": {
              "properties": {
                "rights_decision": {
                  "properties": {
                    "decision": {
                      "const": "COMPATIBLE"
                    }
                  }
                }
              }
            }
          },
          "teacher_outputs": {
            "items": {
              "properties": {
                "contamination_status": {
                  "const": "CLEAR"
                }
              }
            }
          },
          "verifier_health": {
            "properties": {
              "health_class": {
                "const": "HEALTHY"
              },
              "independence": {
                "const": "INDEPENDENT"
              },
              "teacher_output_sole_authority": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admission_decision": {
            "const": "REJECT"
          }
        },
        "required": [
          "admission_decision"
        ]
      },
      "then": {
        "properties": {
          "admission_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "admission_decision": {
      "enum": [
        "ADMIT",
        "REJECT"
      ]
    },
    "admission_reasons": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "contamination_status": {
      "enum": [
        "CLEAR",
        "DETECTED",
        "UNRESOLVED"
      ]
    },
    "cost_record": {
      "additionalProperties": false,
      "properties": {
        "cost_record_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "currency": {
          "const": "USD"
        },
        "external_effect_authority_identity": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_execution_occurred": {
          "type": "boolean"
        },
        "network_used": {
          "type": "boolean"
        },
        "paid_cost_usd": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "cost_record_identity",
        "currency",
        "paid_cost_usd",
        "network_used",
        "model_execution_occurred",
        "external_effect_authority_identity"
      ],
      "type": "object"
    },
    "independent_execution_results": {
      "items": {
        "$ref": "#/$defs/execution_binding"
      },
      "type": "array",
      "uniqueItems": true
    },
    "output_provenance": {
      "items": {
        "$ref": "#/$defs/provenance_binding"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "output_rights_decisions": {
      "items": {
        "$ref": "#/$defs/rights_binding"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "rescue_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "mstr.teacher-rescue-record.v0"
    },
    "student_failure_evidence": {
      "additionalProperties": false,
      "properties": {
        "attempt_count": {
          "minimum": 1,
          "type": "integer"
        },
        "difficulty_record_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "failure_class": {
          "enum": [
            "UNSOLVED",
            "VERIFIER_REJECTED",
            "TIMEOUT",
            "ERROR",
            "FRONTIER_RESCUE_REQUESTED"
          ]
        },
        "failure_evidence_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "student_model_identity": {
          "$ref": "#/$defs/student_model_identity"
        }
      },
      "required": [
        "failure_evidence_identity",
        "student_model_identity",
        "attempt_count",
        "failure_class",
        "difficulty_record_identity"
      ],
      "type": "object"
    },
    "task_identity": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "teacher_identity": {
      "additionalProperties": false,
      "properties": {
        "access_mode": {
          "enum": [
            "REFERENCE_ONLY",
            "LOCAL_MODEL",
            "REMOTE_API"
          ]
        },
        "model_or_service_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "provider_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "revision_or_version": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "teacher_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "teacher_id",
        "provider_identity",
        "model_or_service_id",
        "revision_or_version",
        "access_mode"
      ],
      "type": "object"
    },
    "teacher_outputs": {
      "items": {
        "$ref": "#/$defs/teacher_output"
      },
      "minItems": 1,
      "type": "array"
    },
    "teacher_terms_identity": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "verifier_health": {
      "additionalProperties": false,
      "properties": {
        "health_class": {
          "enum": [
            "HEALTHY",
            "PARTIAL",
            "DISAGREEMENT",
            "BROKEN",
            "LEAKED",
            "TAMPERED"
          ]
        },
        "independence": {
          "enum": [
            "INDEPENDENT",
            "NOT_INDEPENDENT",
            "UNRESOLVED"
          ]
        },
        "teacher_output_sole_authority": {
          "type": "boolean"
        },
        "verifier_health_record_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "verifier_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "verifier_health_record_identity",
        "verifier_identity",
        "health_class",
        "independence",
        "teacher_output_sole_authority"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "rescue_id",
    "task_identity",
    "student_failure_evidence",
    "teacher_identity",
    "teacher_terms_identity",
    "cost_record",
    "teacher_outputs",
    "output_provenance",
    "output_rights_decisions",
    "contamination_status",
    "independent_execution_results",
    "verifier_health",
    "admission_decision",
    "admission_reasons"
  ],
  "type": "object"
}
