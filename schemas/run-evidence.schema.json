{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mstr.local/schemas/run-evidence-v1.json",
  "title":"MSTR Run Evidence v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","run_id","measurement_protocol","benchmark_manifest_id","task_id","task_manifest_revision",
    "candidate_id","model_revision","artifact_sha256","tokenizer_revision","quantization_method","quantizer_version",
    "runtime_id","runtime_build_flags","hardware_id","interaction_contract_version","context_length","cache_state",
    "seed","sampling_config","verifier_set_id","timings_ms","memory","throughput","sustained_ratio",
    "editor_responsiveness_p95_ms","verifier_results","final_result","invalidation_reason","logs"
  ],
  "properties":{
    "schema_version":{"const":"mstr.run.v1"},
    "run_id":{"type":"string","minLength":1},
    "measurement_protocol":{"type":"string","minLength":1},
    "benchmark_manifest_id":{"type":["string","null"]},
    "task_id":{"type":"string","minLength":1},
    "task_manifest_revision":{"type":"string","minLength":1},
    "candidate_id":{"type":"string","minLength":1},
    "model_revision":{"type":"string","minLength":1},
    "artifact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "tokenizer_revision":{"type":"string","minLength":1},
    "quantization_method":{"type":"string","minLength":1},
    "quantizer_version":{"type":"string","minLength":1},
    "runtime_id":{"type":"string","minLength":1},
    "runtime_build_flags":{"type":"array","items":{"type":"string"}},
    "hardware_id":{"type":"string","minLength":1},
    "interaction_contract_version":{"type":"string","minLength":1},
    "context_length":{"type":"integer","minimum":1},
    "cache_state":{"enum":["process_cold","session_warm","prefix_warm"]},
    "seed":{"type":["integer","null"]},
    "sampling_config":{"type":"object","additionalProperties":true},
    "verifier_set_id":{"type":"string","minLength":1},
    "timings_ms":{
      "type":"object",
      "additionalProperties":false,
      "required":["cold_load","ttfi","ttfa","ttfce","ttvc"],
      "properties":{
        "cold_load":{"type":["number","null"],"minimum":0},
        "ttfi":{"type":["number","null"],"minimum":0},
        "ttfa":{"type":["number","null"],"minimum":0},
        "ttfce":{"type":["number","null"],"minimum":0},
        "ttvc":{"type":["number","null"],"minimum":0}
      }
    },
    "memory":{"type":"object","additionalProperties":true},
    "throughput":{"type":"object","additionalProperties":true},
    "sustained_ratio":{"type":["number","null"],"minimum":0},
    "editor_responsiveness_p95_ms":{"type":["number","null"],"minimum":0},
    "verifier_results":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "final_result":{"enum":["verified_pass","verifier_fail","model_error","tool_error","memory_pressure_fail","timeout","infrastructure_invalid"]},
    "invalidation_reason":{"type":["string","null"]},
    "logs":{"type":"array","items":{"type":"string"}}
  }
}
