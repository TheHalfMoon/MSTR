{
  "$id": "https://mstr.local/schemas/mstr-trajectory-manifest-v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "terminal_class": {
            "enum": [
              "VERIFIED_SUCCESS",
              "RECOVERED_SUCCESS"
            ]
          }
        },
        "required": [
          "terminal_class"
        ]
      },
      "then": {
        "properties": {
          "contamination_status": {
            "const": "CLEAR"
          },
          "verifier_result_identity": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_class": {
            "const": "VERIFIED_SUCCESS"
          }
        },
        "required": [
          "terminal_class"
        ]
      },
      "then": {
        "properties": {
          "failure_classes": {
            "maxItems": 0
          },
          "recovery_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_class": {
            "const": "RECOVERED_SUCCESS"
          }
        },
        "required": [
          "terminal_class"
        ]
      },
      "then": {
        "properties": {
          "failure_classes": {
            "minItems": 1
          },
          "recovery_count": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_class": {
            "const": "FAILED_VALID"
          }
        },
        "required": [
          "terminal_class"
        ]
      },
      "then": {
        "properties": {
          "failure_classes": {
            "minItems": 1
          },
          "training_admission": {
            "enum": [
              "ADMITTED_PREFERENCE",
              "ADMITTED_RL_EVIDENCE",
              "EVAL_ONLY",
              "REJECTED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_class": {
            "const": "TIMEOUT_VALID"
          }
        },
        "required": [
          "terminal_class"
        ]
      },
      "then": {
        "properties": {
          "failure_classes": {
            "contains": {
              "const": "TIMEOUT"
            },
            "minContains": 1
          },
          "training_admission": {
            "enum": [
              "ADMITTED_PREFERENCE",
              "ADMITTED_RL_EVIDENCE",
              "EVAL_ONLY",
              "REJECTED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_class": {
            "const": "INVALID_ENVIRONMENT"
          }
        },
        "required": [
          "terminal_class"
        ]
      },
      "then": {
        "properties": {
          "failure_classes": {
            "contains": {
              "const": "ENVIRONMENT_FAILURE"
            },
            "minContains": 1
          },
          "training_admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_class": {
            "const": "INVALID_VERIFIER"
          }
        },
        "required": [
          "terminal_class"
        ]
      },
      "then": {
        "properties": {
          "failure_classes": {
            "contains": {
              "const": "VERIFIER_FAILURE"
            },
            "minContains": 1
          },
          "training_admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_class": {
            "enum": [
              "CONTAMINATED",
              "LEAKAGE_DETECTED"
            ]
          }
        },
        "required": [
          "terminal_class"
        ]
      },
      "then": {
        "properties": {
          "training_admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_class": {
            "const": "AUTHORITY_VIOLATION"
          }
        },
        "required": [
          "terminal_class"
        ]
      },
      "then": {
        "properties": {
          "authority_violations": {
            "minItems": 1
          },
          "failure_classes": {
            "contains": {
              "const": "AUTHORITY_VIOLATION"
            },
            "minContains": 1
          },
          "training_admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contamination_status": {
            "enum": [
              "SUSPECT",
              "REJECTED"
            ]
          }
        },
        "required": [
          "contamination_status"
        ]
      },
      "then": {
        "properties": {
          "training_admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_violations": {
            "minItems": 1
          }
        },
        "required": [
          "authority_violations"
        ]
      },
      "then": {
        "properties": {
          "training_admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "source_class": {
                "enum": [
                  "PRIVATE_USER_REPOSITORY",
                  "PRODUCTION_TRACE"
                ]
              }
            },
            "required": [
              "source_class"
            ]
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "properties": {
          "training_admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "provenance_status": {
                "enum": [
                  "INCOMPLETE",
                  "UNRESOLVED"
                ]
              }
            },
            "required": [
              "provenance_status"
            ]
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "properties": {
          "training_admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "rights_status": {
                "enum": [
                  "INCOMPATIBLE",
                  "UNRESOLVED"
                ]
              }
            },
            "required": [
              "rights_status"
            ]
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "properties": {
          "training_admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "secret_scan_status": {
                "const": "DETECTED"
              }
            },
            "required": [
              "secret_scan_status"
            ]
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "properties": {
          "training_admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "training_admission": {
            "enum": [
              "ADMITTED_SFT",
              "ADMITTED_PREFERENCE",
              "ADMITTED_RL_EVIDENCE"
            ]
          }
        },
        "required": [
          "training_admission"
        ]
      },
      "then": {
        "properties": {
          "verifier_health_binding": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "training_admission": {
            "const": "ADMITTED_SFT"
          }
        },
        "required": [
          "training_admission"
        ]
      },
      "then": {
        "properties": {
          "authority_violations": {
            "maxItems": 0
          },
          "contamination_status": {
            "const": "CLEAR"
          },
          "provenance": {
            "properties": {
              "provenance_status": {
                "const": "COMPLETE"
              },
              "rights_status": {
                "enum": [
                  "COMPATIBLE",
                  "NOT_APPLICABLE"
                ]
              },
              "secret_scan_status": {
                "enum": [
                  "CLEAR",
                  "NOT_APPLICABLE"
                ]
              },
              "source_class": {
                "enum": [
                  "PUBLIC_REPOSITORY",
                  "SYNTHETIC_FIXTURE",
                  "REPOSITORY_OWNED_FIXTURE",
                  "OTHER_GOVERNED"
                ]
              }
            },
            "required": [
              "provenance_status",
              "rights_status",
              "secret_scan_status",
              "source_class"
            ],
            "type": "object"
          },
          "terminal_class": {
            "enum": [
              "VERIFIED_SUCCESS",
              "RECOVERED_SUCCESS"
            ]
          },
          "verifier_health_binding": {
            "properties": {
              "health_class": {
                "const": "HEALTHY"
              },
              "stage_admission_class": {
                "const": "CLEAN_POSITIVE_ELIGIBLE"
              }
            },
            "required": [
              "health_class",
              "stage_admission_class"
            ],
            "type": "object"
          },
          "verifier_result_identity": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "training_admission": {
            "enum": [
              "ADMITTED_PREFERENCE",
              "ADMITTED_RL_EVIDENCE"
            ]
          }
        },
        "required": [
          "training_admission"
        ]
      },
      "then": {
        "properties": {
          "verifier_health_binding": {
            "properties": {
              "stage_admission_class": {
                "enum": [
                  "CLEAN_POSITIVE_ELIGIBLE",
                  "RESEARCH_DIAGNOSTIC_ONLY"
                ]
              }
            },
            "required": [
              "stage_admission_class"
            ],
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "admission_policy_version": {
      "const": "mstr.trajectory-admission.v0"
    },
    "admission_reasons": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "authority_violations": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "contamination_status": {
      "enum": [
        "CLEAR",
        "SUSPECT",
        "REJECTED"
      ]
    },
    "event_count": {
      "minimum": 1,
      "type": "integer"
    },
    "event_log_schema_version": {
      "const": "mstr.run-event.v0"
    },
    "event_log_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "failure_classes": {
      "items": {
        "enum": [
          "WRONG_LOCALIZATION",
          "BAD_ASSUMPTION",
          "STALE_FILE",
          "BAD_PATCH",
          "SYNTAX_ERROR",
          "TYPE_ERROR",
          "BUILD_FAILURE",
          "TEST_FAILURE",
          "DEPENDENCY_FAILURE",
          "TOOL_ERROR",
          "TIMEOUT",
          "INCOMPLETE_IMPLEMENTATION",
          "OVEREDIT",
          "REGRESSION",
          "FAKE_COMPLETION",
          "AUTHORITY_VIOLATION",
          "ENVIRONMENT_FAILURE",
          "VERIFIER_FAILURE"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "failure_taxonomy_version": {
      "const": "mstr.failure-taxonomy.v0"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "contamination_evidence_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "provenance_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "UNRESOLVED"
          ]
        },
        "rights_status": {
          "enum": [
            "COMPATIBLE",
            "INCOMPATIBLE",
            "UNRESOLVED",
            "NOT_APPLICABLE"
          ]
        },
        "secret_scan_status": {
          "enum": [
            "CLEAR",
            "DETECTED",
            "NOT_APPLICABLE"
          ]
        },
        "source_class": {
          "enum": [
            "PUBLIC_REPOSITORY",
            "SYNTHETIC_FIXTURE",
            "REPOSITORY_OWNED_FIXTURE",
            "PRIVATE_USER_REPOSITORY",
            "PRODUCTION_TRACE",
            "OTHER_GOVERNED"
          ]
        },
        "source_identity": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_class",
        "source_identity",
        "provenance_status",
        "rights_status",
        "secret_scan_status",
        "contamination_evidence_identity"
      ],
      "type": "object"
    },
    "recovery_count": {
      "minimum": 0,
      "type": "integer"
    },
    "run_identity": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "cache_state": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "environment_manifest_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "hardware_profile_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "harness_profile_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "interaction_contract_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "loop_contract_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "model_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "model_revision": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "repository_revision": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "runtime_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "sampling_config": {
          "type": "object"
        },
        "seed": {
          "type": [
            "integer",
            "string"
          ]
        },
        "task_manifest_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "timeout_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        },
        "verifier_manifest_id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "task_manifest_id",
        "repository_revision",
        "environment_manifest_id",
        "model_id",
        "model_revision",
        "artifact_sha256",
        "runtime_id",
        "interaction_contract_id",
        "loop_contract_id",
        "harness_profile_id",
        "verifier_manifest_id",
        "sampling_config",
        "seed",
        "timeout_seconds",
        "cache_state",
        "hardware_profile_id"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "mstr.trajectory-manifest.v0"
    },
    "terminal_class": {
      "enum": [
        "VERIFIED_SUCCESS",
        "RECOVERED_SUCCESS",
        "FAILED_VALID",
        "TIMEOUT_VALID",
        "INVALID_ENVIRONMENT",
        "INVALID_VERIFIER",
        "CONTAMINATED",
        "LEAKAGE_DETECTED",
        "AUTHORITY_VIOLATION"
      ]
    },
    "training_admission": {
      "enum": [
        "ADMITTED_SFT",
        "ADMITTED_PREFERENCE",
        "ADMITTED_RL_EVIDENCE",
        "EVAL_ONLY",
        "REJECTED"
      ]
    },
    "training_labels": {
      "type": "object"
    },
    "trajectory_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "verifier_health_binding": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "health_class": {
                    "enum": [
                      "PARTIAL",
                      "DISAGREEMENT"
                    ]
                  }
                },
                "required": [
                  "health_class"
                ]
              },
              "then": {
                "properties": {
                  "stage_admission_class": {
                    "enum": [
                      "RESEARCH_DIAGNOSTIC_ONLY",
                      "BLOCKED"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "health_class": {
                    "enum": [
                      "BROKEN",
                      "LEAKED",
                      "TAMPERED"
                    ]
                  }
                },
                "required": [
                  "health_class"
                ]
              },
              "then": {
                "properties": {
                  "stage_admission_class": {
                    "const": "BLOCKED"
                  }
                }
              }
            }
          ],
          "properties": {
            "health_class": {
              "enum": [
                "HEALTHY",
                "PARTIAL",
                "DISAGREEMENT",
                "BROKEN",
                "LEAKED",
                "TAMPERED"
              ]
            },
            "schema_version": {
              "const": "mstr.verifier-health.v0"
            },
            "stage_admission_class": {
              "enum": [
                "CLEAN_POSITIVE_ELIGIBLE",
                "RESEARCH_DIAGNOSTIC_ONLY",
                "BLOCKED"
              ]
            },
            "stage_id": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "task_identity": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "verifier_health_id": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "verifier_manifest_id": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "schema_version",
            "verifier_health_id",
            "task_identity",
            "verifier_manifest_id",
            "health_class",
            "stage_id",
            "stage_admission_class"
          ],
          "type": "object"
        }
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "verifier_result_identity": {
      "maxLength": 512,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "trajectory_id",
    "run_identity",
    "event_log_schema_version",
    "event_log_sha256",
    "event_count",
    "failure_taxonomy_version",
    "terminal_class",
    "verifier_result_identity",
    "verifier_health_binding",
    "failure_classes",
    "recovery_count",
    "authority_violations",
    "contamination_status",
    "training_admission",
    "admission_policy_version",
    "admission_reasons",
    "provenance"
  ],
  "title": "MSTR Trajectory Manifest v0",
  "type": "object"
}
