{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mstr.local/schemas/mstr-run-event-v0.json",
  "title": "MSTR Run Event v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "seq",
    "event_type",
    "logical_time",
    "payload",
    "model_visible",
    "source",
    "prev_event_sha256",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mstr.run-event.v0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-based sequence number; must be contiguous within a run (no gaps, no duplicates)."
    },
    "event_type": {
      "enum": [
        "run.started",
        "run.goal_admitted",
        "context.observed",
        "context.compacted",
        "plan.updated",
        "tool.requested",
        "tool.result",
        "edit.proposed",
        "edit.applied",
        "edit.rejected",
        "verifier.started",
        "verifier.result",
        "recovery.started",
        "recovery.result",
        "run.stop_proposed",
        "run.completed",
        "run.failed",
        "run.escalated"
      ]
    },
    "logical_time": {
      "type": "integer",
      "minimum": 0
    },
    "step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "model_visible": {
      "type": "boolean"
    },
    "source": {
      "enum": [
        "user",
        "model",
        "harness",
        "tool",
        "verifier",
        "environment",
        "system"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the canonical UTF-8 serialization of the event object with the sha256 and prev_event_sha256 fields REMOVED, keys sorted lexicographically, separators set to (',', ':'), ensure_ascii=True. This is the deterministic canonical-bytes hash that replay uses for chain verification."
    },
    "prev_event_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the immediately preceding event. Mandatory for all events with seq > 0. The seq=0 event MUST set this to the null-bearing sentinel '0' * 64 (all zeros), not JSON null."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "run.completed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "enum": [
              "harness",
              "verifier",
              "system"
            ]
          },
          "payload": {
            "type": "object",
            "required": [
              "verifier_result_identity",
              "terminal_class"
            ],
            "properties": {
              "verifier_result_identity": {
                "type": "string",
                "minLength": 1
              },
              "terminal_class": {
                "enum": [
                  "VERIFIED_SUCCESS",
                  "RECOVERED_SUCCESS"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "description": "MSTR Run Event v0 — append-oriented event with mandatory SHA-256 integrity hash and optional predecessor binding. Replay MUST reject missing hashes, duplicates, gaps, reordered or substituted events, and broken predecessor chains."
}
