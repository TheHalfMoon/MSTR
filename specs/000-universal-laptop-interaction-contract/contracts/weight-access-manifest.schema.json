{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mstr.local/schemas/weight-access-manifest-v1.json",
  "title": "MSTR Weight-Access Manifest v1",
  "description": "Frozen T027 acquisition manifest for MSTR candidate model artifacts. Pins exact 40-hex upstream revisions, per-file upstream integrity evidence, expected byte budgets, runtime/quantizer candidates, network surface, gating, retention/cleanup. No weight bodies may be downloaded at the T027 stage; this manifest is preparation only. No field may be 'latest', 'main', or 'current'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "generated_at",
    "task",
    "canonical_base",
    "bound",
    "candidates",
    "network",
    "storage_budget",
    "cost",
    "retention_cleanup",
    "git_exclusion",
    "proposed_t028_authority_envelope",
    "unresolved_risks",
    "excluded_pending_rights_clarification"
  ],
  "properties": {
    "schema_version": {
      "const": "mstr.weight-access-manifest.v1"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "const": "MSTR-000 / T027"
    },
    "canonical_base": {
      "type": "string",
      "minLength": 7
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "do_not"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "do_not": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate_entry"
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "allowlist_hosts",
        "redirects_cdns",
        "unauthorized_categories"
      ],
      "properties": {
        "method": {
          "enum": [
            "HTTPS_GET_ONLY"
          ]
        },
        "allowlist_hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "redirects_cdns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unauthorized_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "storage_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_candidate",
        "aggregate",
        "tier"
      ],
      "properties": {
        "per_candidate": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "download_bytes_expected",
              "on_disk_bytes_expected",
              "temporary_bytes_expected"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "download_bytes_expected": {
                "type": "integer",
                "minimum": 0
              },
              "on_disk_bytes_expected": {
                "type": "integer",
                "minimum": 0
              },
              "temporary_bytes_expected": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_download_bytes",
            "total_final_storage_bytes",
            "total_peak_storage_bytes"
          ],
          "properties": {
            "total_download_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "total_final_storage_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "total_peak_storage_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "tier": {
          "type": "string",
          "enum": [
            "PRIMARY_ARTIFACT_BUDGET_LE_3GB",
            "QUALIFICATION_TIER_BUDGET_LE_8GB",
            "ABOVE_UNIVERSAL_LAPTOP_TIER"
          ]
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_monetary_cost",
        "expected_storage_cost",
        "expected_compute_cost",
        "policy"
      ],
      "properties": {
        "expected_monetary_cost": {
          "type": "string",
          "minLength": 1
        },
        "expected_storage_cost": {
          "type": "string",
          "minLength": 1
        },
        "expected_compute_cost": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retention_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_policy",
        "cleanup_policy",
        "cache_policy",
        "artifact_location_policy",
        "git_exclusion_summary"
      ],
      "properties": {
        "retention_policy": {
          "type": "string",
          "minLength": 1
        },
        "cleanup_policy": {
          "type": "string",
          "minLength": 1
        },
        "cache_policy": {
          "type": "string",
          "minLength": 1
        },
        "artifact_location_policy": {
          "type": "string",
          "minLength": 1
        },
        "git_exclusion_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "git_exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weights_ignored",
        "gitignore_covers",
        "verification"
      ],
      "properties": {
        "weights_ignored": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "gitignore_covers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proposed_t028_authority_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stays_blocked_until",
        "explicitly_required_for",
        "what_T028_does",
        "what_T028_does_not",
        "post_T028_does_not_automatically_open"
      ],
      "properties": {
        "stays_blocked_until": {
          "type": "string",
          "minLength": 1
        },
        "explicitly_required_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "what_T028_does": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "what_T028_does_not": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "post_T028_does_not_automatically_open": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_pending_rights_clarification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "candidate_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "role",
        "upstream_repository",
        "exact_model_id",
        "exact_revision",
        "revision_verified_at",
        "artifact_source_hosts",
        "required_artifact_files",
        "optional_artifact_files",
        "explicitly_forbidden_artifacts",
        "tokenizer_files",
        "processor_or_config_files",
        "weight_format",
        "expected_total_download_bytes",
        "expected_total_storage_bytes",
        "temporary_storage_ceiling",
        "expected_file_integrity",
        "post_download_sha256_verification_requirement",
        "artifact_manifest_verification_method",
        "T024_verifier_compatibility",
        "runtime_candidates",
        "quantizer_candidates",
        "runtime_quantizer_status",
        "network_hosts_required_for_acquisition",
        "network_method",
        "authentication_required",
        "account_required",
        "gated_access",
        "clickthrough_required",
        "terms_acceptance_required",
        "license_identity",
        "license_evidence_url",
        "rights_decision",
        "rights_decision_evidence",
        "license_reverification_timestamp",
        "storage_budget",
        "retention_policy",
        "cleanup_policy",
        "cache_policy",
        "artifact_location_policy",
        "git_exclusion_policy",
        "cost_ceiling",
        "expected_monetary_cost",
        "expected_download_storage_aggregate",
        "failure_behavior",
        "recommendation"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "foundation",
            "architecture_control",
            "coder_control"
          ]
        },
        "upstream_repository": {
          "type": "string",
          "minLength": 1
        },
        "exact_model_id": {
          "type": "string",
          "minLength": 1
        },
        "exact_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Immutable upstream repository revision pinned as a full 40-hex commit SHA. Moving refs (latest/main/tags) are prohibited on the T028 authority surface."
        },
        "revision_verified_at": {
          "type": "string",
          "minLength": 1
        },
        "artifact_source_hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required_artifact_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "optional_artifact_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explicitly_forbidden_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "tokenizer_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "processor_or_config_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "weight_format": {
          "type": "string",
          "minLength": 1
        },
        "expected_total_download_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "expected_total_storage_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "temporary_storage_ceiling": {
          "type": "integer",
          "minimum": 0
        },
        "post_download_sha256_verification_requirement": {
          "type": "string",
          "minLength": 1
        },
        "artifact_manifest_verification_method": {
          "type": "string",
          "minLength": 1
        },
        "T024_verifier_compatibility": {
          "type": "string",
          "minLength": 1
        },
        "runtime_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "quantizer_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "runtime_quantizer_status": {
          "type": "string",
          "enum": [
            "CANDIDATE_ONLY_NEEDS_T029_T030",
            "SELECTED",
            "REJECTED"
          ]
        },
        "network_hosts_required_for_acquisition": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "network_method": {
          "const": "HTTPS_GET_ONLY"
        },
        "authentication_required": {
          "type": "boolean"
        },
        "account_required": {
          "type": "boolean"
        },
        "gated_access": {
          "type": "boolean"
        },
        "clickthrough_required": {
          "type": "boolean"
        },
        "terms_acceptance_required": {
          "type": "boolean"
        },
        "license_identity": {
          "type": "string",
          "minLength": 1
        },
        "license_evidence_url": {
          "type": "string",
          "minLength": 1
        },
        "rights_decision": {
          "enum": [
            "READY_FOR_T028",
            "EXCLUDED_RIGHTS",
            "EXCLUDED_GATED",
            "EXCLUDED_ARTIFACT_UNRESOLVED",
            "EXCLUDED_STORAGE",
            "REFERENCE_ONLY",
            "BLOCKED_NEEDS_FOUNDER"
          ]
        },
        "rights_decision_evidence": {
          "type": "string",
          "minLength": 1
        },
        "license_reverification_timestamp": {
          "type": "string",
          "minLength": 1
        },
        "storage_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "download_bytes_expected",
            "on_disk_bytes_expected",
            "temporary_bytes_expected"
          ],
          "properties": {
            "download_bytes_expected": {
              "type": "integer",
              "minimum": 0
            },
            "on_disk_bytes_expected": {
              "type": "integer",
              "minimum": 0
            },
            "temporary_bytes_expected": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "retention_policy": {
          "type": "string",
          "minLength": 1
        },
        "cleanup_policy": {
          "type": "string",
          "minLength": 1
        },
        "cache_policy": {
          "type": "string",
          "minLength": 1
        },
        "artifact_location_policy": {
          "type": "string",
          "minLength": 1
        },
        "git_exclusion_policy": {
          "type": "string",
          "minLength": 1
        },
        "cost_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "expected_monetary_cost": {
          "type": "string",
          "minLength": 1
        },
        "expected_download_storage_aggregate": {
          "type": "string",
          "minLength": 1
        },
        "failure_behavior": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "enum": [
            "READY_FOR_T028",
            "EXCLUDED_RIGHTS",
            "EXCLUDED_GATED",
            "EXCLUDED_ARTIFACT_UNRESOLVED",
            "EXCLUDED_STORAGE",
            "REFERENCE_ONLY",
            "BLOCKED_NEEDS_FOUNDER"
          ]
        },
        "expected_file_integrity": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "expected_size_bytes",
              "upstream_sha256"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "expected_size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "upstream_sha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                ]
              }
            }
          },
          "description": "Per-file upstream integrity evidence captured from the provider at the pinned revision (LFS OID SHA-256 plus exact byte size). Weight files MUST carry a non-null upstream SHA-256; tiny non-LFS text files may carry null."
        }
      }
    }
  }
}
