{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mstr.local/schemas/mstr-data-constitution-v0.json",
  "title": "MSTR Data Constitution v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "constitution_id", "version", "allowed_source_classes",
    "prohibited_source_classes", "software_role_taxonomy", "target_distribution_policy",
    "language_target_policy", "provenance_policy", "rights_policy", "contamination_policy",
    "dedup_policy", "benchmark_exclusion_policy", "synthetic_policy",
    "student_generated_policy", "teacher_policy", "difficulty_policy",
    "verifier_health_thresholds", "training_eval_boundary_policy",
    "stage_admission_rules", "private_user_data_policy"
  ],
  "properties": {
    "schema_version": {"const": "mstr.data-constitution.v0"},
    "constitution_id": {"const": "MSTR-DATA-CONSTITUTION-v0"},
    "version": {"const": "0"},
    "allowed_source_classes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": [
        "PUBLIC_OPEN_SOURCE_REPOSITORY", "PUBLIC_DATASET_COMPATIBLE_RIGHTS",
        "PUBLIC_DOCUMENTATION_COMPATIBLE_RIGHTS", "REPOSITORY_OWNED_FIXTURE",
        "SYNTHETIC_VERIFIED", "STUDENT_GENERATED_VERIFIED", "TEACHER_OUTPUT_VERIFIED"
      ]}
    },
    "prohibited_source_classes": {
      "type": "array", "minItems": 8, "uniqueItems": true,
      "items": {"enum": [
        "PRIVATE_USER_REPOSITORY", "PRODUCTION_TRACE", "UNKNOWN_PROVENANCE",
        "UNRESOLVED_RIGHTS", "BENCHMARK_EVALUATION_ITEM", "FUTURE_HISTORY_LEAKAGE",
        "UNVERIFIED_SYNTHETIC", "UNVERIFIED_TEACHER_OUTPUT"
      ]},
      "allOf": [
        {"contains": {"const": "PRIVATE_USER_REPOSITORY"}},
        {"contains": {"const": "PRODUCTION_TRACE"}},
        {"contains": {"const": "UNKNOWN_PROVENANCE"}},
        {"contains": {"const": "UNRESOLVED_RIGHTS"}},
        {"contains": {"const": "BENCHMARK_EVALUATION_ITEM"}},
        {"contains": {"const": "FUTURE_HISTORY_LEAKAGE"}},
        {"contains": {"const": "UNVERIFIED_SYNTHETIC"}},
        {"contains": {"const": "UNVERIFIED_TEACHER_OUTPUT"}}
      ]
    },
    "software_role_taxonomy": {
      "const": [
        "CODE", "FIM", "TEST", "DIFF", "BUILD_CI", "TOOL_SHELL",
        "ISSUE_DIRECTION", "PR_REVIEW", "SOFTWARE_EVOLUTION", "REPAIR_RECOVERY",
        "FEATURE_GREENFIELD", "SECURITY", "GENERAL_REASONING_REPLAY"
      ]
    },
    "target_distribution_policy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "mode", "fixed_percentages_in_b014", "software_role_distribution_required",
        "stage_specific_manifest_required", "evidence_selected_mix_required",
        "role_coverage_may_not_be_silently_zeroed"
      ],
      "properties": {
        "mode": {"const": "STAGE_SPECIFIC_MANIFEST"},
        "fixed_percentages_in_b014": {"const": false},
        "software_role_distribution_required": {"const": true},
        "stage_specific_manifest_required": {"const": true},
        "evidence_selected_mix_required": {"const": true},
        "role_coverage_may_not_be_silently_zeroed": {"const": true}
      }
    },
    "language_target_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "required_policy_task_id", "must_be_bound_before_training_admission"],
      "properties": {
        "mode": {"const": "EXTERNAL_CANONICAL_POLICY"},
        "required_policy_task_id": {"const": "B015"},
        "must_be_bound_before_training_admission": {"const": true}
      }
    },
    "provenance_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["source_identity_required", "source_revision_or_snapshot_required", "acquisition_time_required", "artifact_lineage_required", "unresolved_provenance_admission"],
      "properties": {
        "source_identity_required": {"const": true},
        "source_revision_or_snapshot_required": {"const": true},
        "acquisition_time_required": {"const": true},
        "artifact_lineage_required": {"const": true},
        "unresolved_provenance_admission": {"const": "REJECT"}
      }
    },
    "rights_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["license_or_terms_identity_required", "concrete_rights_decision_required", "unresolved_rights_admission", "incompatible_rights_admission", "teacher_terms_do_not_substitute_output_rights"],
      "properties": {
        "license_or_terms_identity_required": {"const": true},
        "concrete_rights_decision_required": {"const": true},
        "unresolved_rights_admission": {"const": "REJECT"},
        "incompatible_rights_admission": {"const": "REJECT"},
        "teacher_terms_do_not_substitute_output_rights": {"const": true}
      }
    },
    "contamination_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmark_overlap_check_required", "future_history_leakage_check_required", "cross_split_contamination_check_required", "unresolved_contamination_admission"],
      "properties": {
        "benchmark_overlap_check_required": {"const": true},
        "future_history_leakage_check_required": {"const": true},
        "cross_split_contamination_check_required": {"const": true},
        "unresolved_contamination_admission": {"const": "REJECT"}
      }
    },
    "dedup_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_dedup_required", "near_duplicate_detection_required", "cross_split_dedup_required", "provenance_preserved_after_dedup"],
      "properties": {
        "exact_dedup_required": {"const": true},
        "near_duplicate_detection_required": {"const": true},
        "cross_split_dedup_required": {"const": true},
        "provenance_preserved_after_dedup": {"const": true}
      }
    },
    "benchmark_exclusion_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmark_eval_items_in_training", "hidden_tests_in_training", "benchmark_derived_solution_leakage", "near_duplicate_guard_required"],
      "properties": {
        "benchmark_eval_items_in_training": {"const": "PROHIBITED"},
        "hidden_tests_in_training": {"const": "PROHIBITED"},
        "benchmark_derived_solution_leakage": {"const": "PROHIBITED"},
        "near_duplicate_guard_required": {"const": true}
      }
    },
    "synthetic_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["generator_identity_required", "generation_provenance_required", "rights_decision_required", "verifier_evidence_required", "contamination_check_required", "unverified_admission"],
      "properties": {
        "generator_identity_required": {"const": true},
        "generation_provenance_required": {"const": true},
        "rights_decision_required": {"const": true},
        "verifier_evidence_required": {"const": true},
        "contamination_check_required": {"const": true},
        "unverified_admission": {"const": "REJECT"}
      }
    },
    "student_generated_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["seed_provenance_required", "seed_rights_required", "per_artifact_provenance_required", "per_artifact_rights_required", "sandbox_execution_required", "independent_verifier_required", "contamination_check_required", "difficulty_record_required", "unresolved_admission"],
      "properties": {
        "seed_provenance_required": {"const": true},
        "seed_rights_required": {"const": true},
        "per_artifact_provenance_required": {"const": true},
        "per_artifact_rights_required": {"const": true},
        "sandbox_execution_required": {"const": true},
        "independent_verifier_required": {"const": true},
        "contamination_check_required": {"const": true},
        "difficulty_record_required": {"const": true},
        "unresolved_admission": {"const": "REJECT"}
      }
    },
    "teacher_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["teacher_identity_required", "teacher_terms_identity_required", "concrete_output_provenance_required", "concrete_output_rights_required", "independent_execution_required", "verifier_health_required", "contamination_check_required", "teacher_identity_is_truth", "unresolved_admission", "paid_or_api_teacher_authorized_by_constitution"],
      "properties": {
        "teacher_identity_required": {"const": true},
        "teacher_terms_identity_required": {"const": true},
        "concrete_output_provenance_required": {"const": true},
        "concrete_output_rights_required": {"const": true},
        "independent_execution_required": {"const": true},
        "verifier_health_required": {"const": true},
        "contamination_check_required": {"const": true},
        "teacher_identity_is_truth": {"const": false},
        "unresolved_admission": {"const": "REJECT"},
        "paid_or_api_teacher_authorized_by_constitution": {"const": false}
      }
    },
    "difficulty_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint_relative", "student_identity_required", "harness_identity_required", "sampling_identity_required", "classes", "invalid_positive_admission"],
      "properties": {
        "checkpoint_relative": {"const": true},
        "student_identity_required": {"const": true},
        "harness_identity_required": {"const": true},
        "sampling_identity_required": {"const": true},
        "classes": {"const": ["TOO_EASY", "LEARNABLE_FRONTIER", "HARD_FRONTIER", "CURRENTLY_UNPRODUCTIVE", "INVALID"]},
        "invalid_positive_admission": {"const": "REJECT"}
      }
    },
    "verifier_health_thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["clean_positive_allowed_classes", "research_only_classes", "blocked_classes"],
      "properties": {
        "clean_positive_allowed_classes": {"const": ["HEALTHY"]},
        "research_only_classes": {"const": ["HEALTHY", "PARTIAL", "DISAGREEMENT"]},
        "blocked_classes": {"const": ["BROKEN", "LEAKED", "TAMPERED"]}
      }
    },
    "training_eval_boundary_policy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "training_only_identity_required", "evaluation_only_identity_required",
        "held_out_identity_required", "cross_split_dedup_required",
        "benchmark_exclusion_identity_required", "future_history_visibility_required",
        "hidden_tests_training_visibility"
      ],
      "properties": {
        "training_only_identity_required": {"const": true},
        "evaluation_only_identity_required": {"const": true},
        "held_out_identity_required": {"const": true},
        "cross_split_dedup_required": {"const": true},
        "benchmark_exclusion_identity_required": {"const": true},
        "future_history_visibility_required": {"const": true},
        "hidden_tests_training_visibility": {"const": "PROHIBITED"}
      }
    },
    "stage_admission_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_complete", "rights_compatible", "contamination_clear", "benchmark_exclusion_clear", "dedup_complete", "verifier_health_threshold_met", "language_target_policy_bound", "target_distribution_manifest_bound", "training_eval_boundary_explicit", "private_user_data_default_rejection_enforced", "unresolved_evidence_admission"],
      "properties": {
        "provenance_complete": {"const": true},
        "rights_compatible": {"const": true},
        "contamination_clear": {"const": true},
        "benchmark_exclusion_clear": {"const": true},
        "dedup_complete": {"const": true},
        "verifier_health_threshold_met": {"const": true},
        "language_target_policy_bound": {"const": true},
        "target_distribution_manifest_bound": {"const": true},
        "training_eval_boundary_explicit": {"const": true},
        "private_user_data_default_rejection_enforced": {"const": true},
        "unresolved_evidence_admission": {"const": "REJECT"}
      }
    },
    "private_user_data_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["default_admission", "private_user_repositories_default_ingest", "production_traces_default_ingest", "hidden_telemetry_allowed", "future_exception_requires_separate_policy_and_authority"],
      "properties": {
        "default_admission": {"const": "REJECT"},
        "private_user_repositories_default_ingest": {"const": false},
        "production_traces_default_ingest": {"const": false},
        "hidden_telemetry_allowed": {"const": false},
        "future_exception_requires_separate_policy_and_authority": {"const": true}
      }
    }
  }
}
