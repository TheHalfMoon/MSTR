{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mstr.local/specs/002-code-model-supremacy-foundation/contracts/b005-code-backbone-discovery-v1.schema.json",
  "title": "MSTR-000B B005 Code Backbone Discovery v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "format_semantics",
    "task_id",
    "workstream_id",
    "canonical_main_sha",
    "observed_at_utc",
    "scope",
    "canonical_inputs",
    "candidates",
    "newly_relevant_for_b006",
    "existing_records_requiring_material_revalidation",
    "b005_conclusions",
    "no_weight_access_performed",
    "no_authority_created"
  ],
  "properties": {
    "format_version": {"const": "mstr.b005.discovery.v1"},
    "format_semantics": {"type": "string", "minLength": 1},
    "task_id": {"const": "B005"},
    "workstream_id": {"const": "MSTR-000B"},
    "canonical_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observed_at_utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_metadata_only",
        "model_weight_access",
        "model_execution",
        "tokenizer_artifact_download",
        "paid_compute",
        "large_dataset_ingestion",
        "gated_terms_acceptance",
        "founder_machine_large_artifacts"
      ],
      "properties": {
        "public_metadata_only": {"const": true},
        "model_weight_access": {"const": false},
        "model_execution": {"const": false},
        "tokenizer_artifact_download": {"const": false},
        "paid_compute": {"const": false},
        "large_dataset_ingestion": {"const": false},
        "gated_terms_acceptance": {"const": false},
        "founder_machine_large_artifacts": {"const": false}
      }
    },
    "canonical_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo_id",
          "current_revision",
          "revision_status",
          "existing_candidate_id",
          "specialization",
          "provenance_observation",
          "license_observation",
          "access_gate_observation",
          "parameter_observation",
          "context_observation_tokens",
          "intended_use_observation",
          "material_flags",
          "source_urls"
        ],
        "properties": {
          "repo_id": {"type": "string", "minLength": 1},
          "current_revision": {"type": ["string", "null"]},
          "revision_status": {"enum": ["EXACT_FULL_SHA", "SHORT_SHA_ONLY", "UNRESOLVED_GATED_METADATA"]},
          "existing_candidate_id": {"type": ["string", "null"]},
          "specialization": {"type": "string", "minLength": 1},
          "provenance_observation": {"type": "string", "minLength": 1},
          "license_observation": {"type": "string", "minLength": 1},
          "access_gate_observation": {"type": "string", "minLength": 1},
          "parameter_observation": {"type": "string", "minLength": 1},
          "context_observation_tokens": {"type": "integer", "minimum": 1},
          "intended_use_observation": {"type": "string", "minLength": 1},
          "material_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {"properties": {"revision_status": {"const": "EXACT_FULL_SHA"}}, "required": ["revision_status"]},
            "then": {"properties": {"current_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}
          },
          {
            "if": {"properties": {"revision_status": {"const": "SHORT_SHA_ONLY"}}, "required": ["revision_status"]},
            "then": {"properties": {"current_revision": {"type": "string", "pattern": "^[0-9a-f]{7,39}$"}}}
          },
          {
            "if": {"properties": {"revision_status": {"const": "UNRESOLVED_GATED_METADATA"}}, "required": ["revision_status"]},
            "then": {"properties": {"current_revision": {"type": "null"}}}
          }
        ]
      }
    },
    "newly_relevant_for_b006": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "existing_records_requiring_material_revalidation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "reason"],
        "properties": {
          "repo_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "b005_conclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "no_weight_access_performed": {"const": true},
    "no_authority_created": {"const": true}
  }
}
