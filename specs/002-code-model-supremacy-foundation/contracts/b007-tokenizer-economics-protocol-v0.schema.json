{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mstr.local/specs/002-code-model-supremacy-foundation/contracts/b007-tokenizer-economics-protocol-v0.schema.json",
  "title": "B007 Tokenizer Economics Protocol v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "task_id", "workstream_id", "protocol_id", "canonical_main_sha", "claim_scope", "corpus", "integrity_preflight", "tokenizer_identity", "encoding_contract", "metrics", "comparability", "b008_output_requirements", "authority"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "category": {"enum": ["python", "typescript", "javascript", "rust", "go", "java", "c", "cpp", "sql", "shell", "json", "yaml", "toml", "diff", "stack_trace", "file_paths", "tool_json"]},
    "profile": {"enum": ["baseline", "adversarial"]}
  },
  "properties": {
    "format_version": {"const": "mstr.tokenizer-economics-protocol.v0"},
    "task_id": {"const": "B007"},
    "workstream_id": {"const": "MSTR-000B"},
    "protocol_id": {"const": "MSTR-TOKENIZER-ECONOMICS-v0"},
    "canonical_main_sha": {"const": "9b4e885f215fd922ecf79ff9e15bdb1479396668"},
    "claim_scope": {"const": "DETERMINISTIC_STRATIFIED_V0_FIXTURE_NOT_A_POPULATION_REPRESENTATIVE_SAMPLE"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "fixture_path", "fixture_sha256", "fixture_file_bytes", "expected_git_blob_sha1", "decoded_content_bytes", "entry_count", "entry_byte_distribution", "encoding", "newline", "source_class", "external_source_content", "profiles_required", "required_categories", "category_summary", "entry_pins"],
      "properties": {
        "corpus_id": {"const": "B007-tokenizer-economics-v0"},
        "fixture_path": {"const": "benchmarks/fixtures/tokenizer-economics/B007-corpus.json"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_file_bytes": {"type": "integer", "minimum": 1},
        "expected_git_blob_sha1": {"$ref": "#/$defs/git_sha1"},
        "decoded_content_bytes": {"type": "integer", "minimum": 1},
        "entry_count": {"const": 34},
        "entry_byte_distribution": {
          "type": "object", "additionalProperties": false, "required": ["min", "median", "max"],
          "properties": {"min": {"type": "integer", "minimum": 1}, "median": {"type": "number", "minimum": 1}, "max": {"type": "integer", "minimum": 1}}
        },
        "encoding": {"const": "UTF-8"},
        "newline": {"const": "LF"},
        "source_class": {"const": "REPOSITORY_AUTHORED_SYNTHETIC_FIXTURE"},
        "external_source_content": {"const": false},
        "profiles_required": {"const": ["baseline", "adversarial"]},
        "required_categories": {"const": ["python", "typescript", "javascript", "rust", "go", "java", "c", "cpp", "sql", "shell", "json", "yaml", "toml", "diff", "stack_trace", "file_paths", "tool_json"]},
        "category_summary": {
          "type": "array", "minItems": 17, "maxItems": 17,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["category", "entry_count", "decoded_bytes", "min_entry_bytes", "max_entry_bytes", "profiles"],
            "properties": {
              "category": {"$ref": "#/$defs/category"}, "entry_count": {"const": 2},
              "decoded_bytes": {"type": "integer", "minimum": 1}, "min_entry_bytes": {"type": "integer", "minimum": 1},
              "max_entry_bytes": {"type": "integer", "minimum": 1}, "profiles": {"const": ["baseline", "adversarial"]}
            }
          }
        },
        "entry_pins": {
          "type": "array", "minItems": 34, "maxItems": 34,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fixture_id", "category", "profile", "byte_count", "sha256"],
            "properties": {
              "fixture_id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "category": {"$ref": "#/$defs/category"},
              "profile": {"$ref": "#/$defs/profile"}, "byte_count": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "integrity_preflight": {
      "type": "object", "additionalProperties": false,
      "required": ["strict_json_duplicate_key_rejection_required", "verify_fixture_file_sha256", "verify_fixture_file_bytes", "verify_expected_git_blob_sha1", "verify_entry_order_and_unique_ids", "verify_required_categories_and_profiles", "verify_each_decoded_content_byte_count", "verify_each_decoded_content_sha256", "verify_aggregate_decoded_content_bytes", "verify_manifest_entry_pins", "fail_closed_on_any_mismatch", "content_transformation_before_tokenization", "authoritative_serialization_rule"],
      "properties": {
        "strict_json_duplicate_key_rejection_required": {"const": true}, "verify_fixture_file_sha256": {"const": true},
        "verify_fixture_file_bytes": {"const": true}, "verify_expected_git_blob_sha1": {"const": true},
        "verify_entry_order_and_unique_ids": {"const": true}, "verify_required_categories_and_profiles": {"const": true},
        "verify_each_decoded_content_byte_count": {"const": true}, "verify_each_decoded_content_sha256": {"const": true},
        "verify_aggregate_decoded_content_bytes": {"const": true}, "verify_manifest_entry_pins": {"const": true},
        "fail_closed_on_any_mismatch": {"const": true}, "content_transformation_before_tokenization": {"const": "NONE"},
        "authoritative_serialization_rule": {"const": "COMMITTED_CORPUS_FILE_BYTES_AND_DECODED_ENTRY_HASHES_ARE_AUTHORITATIVE"}
      }
    },
    "tokenizer_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["tokenizer_repository_or_id_required", "immutable_tokenizer_revision_required", "all_loaded_tokenizer_artifact_sha256_inventory_required", "tokenizer_implementation_id_required", "tokenizer_implementation_version_required", "measurement_runtime_identity_required", "platform_identity_required_when_behavior_can_differ", "acquisition_source_and_provenance_required"],
      "properties": {
        "tokenizer_repository_or_id_required": {"const": true}, "immutable_tokenizer_revision_required": {"const": true},
        "all_loaded_tokenizer_artifact_sha256_inventory_required": {"const": true}, "tokenizer_implementation_id_required": {"const": true},
        "tokenizer_implementation_version_required": {"const": true},
        "measurement_runtime_identity_required": {"const": ["python_version", "tokenizer_library", "tokenizer_library_version", "tokenizer_implementation_class", "executor_identity"]},
        "platform_identity_required_when_behavior_can_differ": {"const": true}, "acquisition_source_and_provenance_required": {"const": true}
      }
    },
    "encoding_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["input_field", "decode", "tokenize_text", "add_special_tokens", "bos_injection", "eos_injection", "chat_template", "padding", "truncation", "pre_measurement_whitespace_normalization", "pre_measurement_newline_normalization", "tokenizer_native_normalizer", "effective_runtime_settings_capture_required", "token_count_api_identity_required", "offset_mapping_capability_and_observation_required", "overflow_or_truncation_observation_required"],
      "properties": {
        "input_field": {"const": "entries[].content_utf8"}, "decode": {"const": "JSON_STRING_TO_UNICODE_THEN_UTF8_BYTES_FOR_BYTE_METRICS"},
        "tokenize_text": {"const": "EXACT_DECODED_UNICODE_STRING"}, "add_special_tokens": {"const": false}, "bos_injection": {"const": false},
        "eos_injection": {"const": false}, "chat_template": {"const": "PROHIBITED_AND_MUST_BE_ASSERTED_UNUSED"}, "padding": {"const": "NONE"},
        "truncation": {"const": "NONE"}, "pre_measurement_whitespace_normalization": {"const": "NONE"},
        "pre_measurement_newline_normalization": {"const": "NONE"}, "tokenizer_native_normalizer": {"const": "AS_PINNED_BY_TOKENIZER_REVISION"},
        "effective_runtime_settings_capture_required": {"const": true}, "token_count_api_identity_required": {"const": true},
        "offset_mapping_capability_and_observation_required": {"const": true}, "overflow_or_truncation_observation_required": {"const": true}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["per_entry_required", "identifier_like_regex", "identifier_like_semantics", "identifier_like_counting", "identifier_like_zero_match_behavior", "identifier_like_measurement", "aggregate_required", "per_category_required", "weighted_bytes_per_token_formula", "weighted_characters_per_token_formula", "estimated_effective_payload_bytes_at_8192_tokens_formula", "zero_total_tokens_behavior", "estimated_payload_semantics", "required_structural_observations", "required_named_surfaces"],
      "properties": {
        "per_entry_required": {"const": ["byte_count", "token_count", "bytes_per_token", "character_count", "characters_per_token", "identifier_like_occurrence_count", "identifier_like_token_piece_count", "mean_tokens_per_identifier_like_occurrence", "p50_tokens_per_identifier_like_occurrence", "p95_tokens_per_identifier_like_occurrence", "max_tokens_per_identifier_like_occurrence", "multi_token_identifier_like_occurrence_fraction"]},
        "identifier_like_regex": {"const": "[A-Za-z_][A-Za-z0-9_]*"},
        "identifier_like_semantics": {"const": "LEXICAL_ASCII_IDENTIFIER_LIKE_SPANS_NOT_LANGUAGE_AWARE_IDENTIFIERS"},
        "identifier_like_counting": {"const": "COUNT_OCCURRENCES_WITHOUT_DEDUPLICATION"},
        "identifier_like_zero_match_behavior": {"const": "REPORT_COUNT_0_AND_NULL_RATIO_DISTRIBUTION_FIELDS"},
        "identifier_like_measurement": {"const": "Encode each matched span in isolation with add_special_tokens=false; record token-piece API identity."},
        "aggregate_required": {"const": ["total_bytes", "total_characters", "total_tokens", "weighted_bytes_per_token", "weighted_characters_per_token", "estimated_effective_payload_bytes_at_8192_tokens", "per_category_metrics", "numerator_denominator_totals"]},
        "per_category_required": {"const": ["entry_count", "total_bytes", "total_characters", "total_tokens", "weighted_bytes_per_token", "weighted_characters_per_token"]},
        "weighted_bytes_per_token_formula": {"const": "SUM(byte_count) / SUM(token_count)"},
        "weighted_characters_per_token_formula": {"const": "SUM(character_count) / SUM(token_count)"},
        "estimated_effective_payload_bytes_at_8192_tokens_formula": {"const": "FLOOR((SUM(byte_count) / SUM(token_count)) * 8192)"},
        "zero_total_tokens_behavior": {"const": "INVALID_MEASUREMENT"},
        "estimated_payload_semantics": {"const": "CORPUS_RATIO_ESTIMATE_NOT_AN_EXACT_MODEL_CONTEXT_MAXIMUM"},
        "required_structural_observations": {
          "type": "object", "additionalProperties": false, "required": ["diff", "file_paths", "stack_trace", "tool_json"],
          "properties": {
            "diff": {"const": ["hunk_count", "added_line_count", "deleted_line_count", "context_line_count", "renames_or_binary_markers_present"]},
            "file_paths": {"const": ["path_count", "max_depth", "extension_counts", "windows_or_unc_path_present", "unicode_path_present"]},
            "stack_trace": {"const": ["frame_count", "runtime_family", "async_or_cause_markers_present"]},
            "tool_json": {"const": ["max_json_nesting_depth", "array_count", "object_count", "error_object_present"]}
          }
        },
        "required_named_surfaces": {
          "type": "object", "additionalProperties": false, "required": ["diff_tokens", "stacktrace_tokens", "tool_json_tokens", "path_tokens"],
          "properties": {"diff_tokens": {"const": "category=diff"}, "stacktrace_tokens": {"const": "category=stack_trace"}, "tool_json_tokens": {"const": "category=tool_json"}, "path_tokens": {"const": "category=file_paths"}}
        }
      }
    },
    "comparability": {
      "type": "object", "additionalProperties": false,
      "required": ["same_protocol_id_required", "same_corpus_fixture_sha256_required", "same_entry_hashes_required", "same_special_token_policy_required", "same_aggregation_formula_required", "same_effective_settings_policy_required", "candidate_tokenizer_revision_may_differ", "missing_identity_or_integrity_evidence", "protocol_or_corpus_drift_requires_new_protocol_version_or_explicit_noncomparable_result"],
      "properties": {
        "same_protocol_id_required": {"const": true}, "same_corpus_fixture_sha256_required": {"const": true}, "same_entry_hashes_required": {"const": true},
        "same_special_token_policy_required": {"const": true}, "same_aggregation_formula_required": {"const": true}, "same_effective_settings_policy_required": {"const": true},
        "candidate_tokenizer_revision_may_differ": {"const": true}, "missing_identity_or_integrity_evidence": {"const": "INVALID_FOR_DIRECT_COMPARISON"},
        "protocol_or_corpus_drift_requires_new_protocol_version_or_explicit_noncomparable_result": {"const": true}
      }
    },
    "b008_output_requirements": {"const": ["candidate_id", "tokenizer_id", "tokenizer_revision", "loaded_tokenizer_artifact_sha256_inventory", "tokenizer_implementation_id", "tokenizer_implementation_version", "measurement_runtime_identity", "effective_runtime_settings", "token_count_api_identity", "acquisition_source_and_provenance", "protocol_id", "corpus_fixture_sha256", "per_entry_metrics", "per_category_metrics", "aggregate_metrics", "structural_observations", "measurement_failures", "measured_at", "executor_identity"]},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["model_inference_authorized", "model_weight_access_authorized", "paid_compute_authorized", "large_dataset_ingestion_authorized", "tokenizer_measurement_authorized_by_b007", "note"],
      "properties": {
        "model_inference_authorized": {"const": false}, "model_weight_access_authorized": {"const": false}, "paid_compute_authorized": {"const": false},
        "large_dataset_ingestion_authorized": {"const": false}, "tokenizer_measurement_authorized_by_b007": {"const": false},
        "note": {"const": "B007 freezes bytes and protocol only. B008 owns actual tokenizer measurement and any separately required tokenizer acquisition authority."}
      }
    }
  }
}
